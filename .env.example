# Server environment.
# Copy this file to .env and replace every placeholder.
# Do not commit .env. This example contains placeholders only.

# Local PostgreSQL from Docker Compose. See docs/postgresql.md.
# The password is only for this local database.
DATABASE_URL=postgresql://sarjy:sarjy@127.0.0.1:5433/sarjy

# Session cookie. SESSION_SECRET is a secret. Use at least 32 random characters.
SESSION_SECRET=replace-with-a-random-session-secret
SESSION_COOKIE_NAME=sarjy_session
SESSION_MAX_AGE_SECONDS=2592000

# LiveKit. The API key and API secret stay on the server.
# NEXT_PUBLIC_LIVEKIT_URL is the browser WebSocket URL. It is not a secret.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Credential for the Python agent. This is a secret.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
INTERNAL_SERVICE_TIMEOUT_MS=5000

# Weather provider. The API key is a secret. The base URL is not.
WEATHER_API_KEY=replace-with-weather-api-key
WEATHER_API_BASE_URL=https://weather.example
