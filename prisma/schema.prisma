// Prisma schema for PostgreSQL.
// The connection string is DATABASE_URL. See prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Application account. Login uses the normalized phone number.
model User {
  /// Primary key. PostgreSQL generates the UUID with gen_random_uuid().
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164 phone number, such as +14155552671. The database rejects a duplicate.
  phoneNumber  String        @unique @map("phone_number") @db.VarChar(16)
  /// Password hash. The plain password is never stored.
  passwordHash String        @map("password_hash")
  /// active can sign in. disabled keeps the phone number reserved.
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  conversations Conversation[]
  memories      Memory[]

  @@map("users")
}

/// A session is valid only when revoked_at is null and expires_at is still in the future.
/// Logout sets revoked_at and keeps the row. The cookie Max-Age uses the same duration as expires_at.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// HMAC-SHA256 hex of the cookie token. The raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Null until logout or another revocation. A non-null value rejects the session.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

/// One call owned by a user.
/// List order is created_at descending, then id descending.
/// active has no ended_at. ended and failed set ended_at and do not return to active.
model Conversation {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  /// LiveKit room name. Generated by the server. Unique.
  roomName  String             @unique @map("room_name") @db.VarChar(64)
  status    ConversationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Set when the call ends or fails. Stays null while the call is active.
  endedAt   DateTime?          @map("ended_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, createdAt])
  @@map("conversations")
}

/// One preference for one user.
/// One row exists for each user and key. A later write for that pair replaces value.
/// created_at stays the first write. updated_at changes when value is replaced.
/// Memory belongs to the user, not to a conversation. It stores no embeddings.
model Memory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Short preference name, such as preferred_name. At most 64 characters.
  key       String   @db.VarChar(64)
  /// The whole JSON value. Replacement overwrites it. It does not merge fields inside the JSON.
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One preference for a user and key. user_id is first, so this also lists one user's keys.
  @@unique([userId, key], map: "memories_user_id_key")
  /// Lists every preference for one user.
  @@index([userId])
  @@map("memories")
}

/// One transcript line. Order in a conversation is created_at ascending, then id ascending.
model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String      @map("conversation_id") @db.Uuid
  role            MessageRole
  content         String
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Provider event id. The same id cannot be stored twice in one conversation.
  providerEventId String?     @map("provider_event_id") @db.VarChar(128)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, providerEventId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Minimal account lifecycle.
enum AccountStatus {
  active
  disabled

  @@map("account_status")
}

/// active can fail or end. ended and failed are final.
enum ConversationStatus {
  active
  ended
  failed

  @@map("conversation_status")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}
